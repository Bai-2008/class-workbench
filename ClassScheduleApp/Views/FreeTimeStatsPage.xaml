<UserControl x:Class="ClassScheduleApp.Views.FreeTimeStatsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 空闲时间统计页：DataContext 由隐式模板继承为 FreeTimeStatsViewModel，后台零逻辑 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：学期 + 周次 + 导出 -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="学期" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox ItemsSource="{Binding Semesters}"
                          SelectedItem="{Binding SelectedSemester}"
                          MinWidth="140" />
                <TextBlock Text="周次" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox ItemsSource="{Binding WeekOptions}"
                          SelectedItem="{Binding SelectedWeek}"
                          MinWidth="80" />
            </StackPanel>
            <Button Content="导出无课表"
                    Command="{Binding ExportWeekCommand}"
                    HorizontalAlignment="Right"
                    Padding="12,4" />
        </Grid>

        <!-- 中部：7 天 × 6 个节次对 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="节次" FontWeight="Bold" Margin="0,0,6,4" />
                    <UniformGrid Grid.Column="1" Columns="7">
                        <TextBlock Text="周一" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周二" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周三" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周四" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周五" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周六" FontWeight="Bold" Margin="2,0,2,4" />
                        <TextBlock Text="周日" FontWeight="Bold" Margin="2,0,2,4" />
                    </UniformGrid>
                </Grid>

                <ItemsControl ItemsSource="{Binding MatrixRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SlotText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Margin="2"
                                                    MinHeight="46"
                                                    Command="{Binding DataContext.SelectCellCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <!-- BasedOn 必须保留：显式样式会完全顶掉主题的隐式按钮样式，
                                                         否则深色下会回落到系统默认按钮（浅底 + 浅蓝悬停） -->
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceAlt}" />
                                                        <Style.Triggers>
                                                            <!-- 全班空闲高亮 -->
                                                            <DataTrigger Binding="{Binding IsAllFree}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource App.Brush.FreeSurface}" />
                                                            </DataTrigger>
                                                            <!-- 当前选中格 -->
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.SelectedBorder}" />
                                                                <Setter Property="BorderThickness" Value="2" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding FreeText}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- 下方：选中时段的空闲 / 有课名单 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding SelectedCellTitle}" FontWeight="Bold" Margin="0,0,0,6" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <TextBlock DockPanel.Dock="Top" Text="空闲名单" Margin="0,0,0,4" />
                    <Button DockPanel.Dock="Bottom"
                            Content="复制空闲名单"
                            Command="{Binding CopyFreeStudentsCommand}"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding FreeStudents}"
                             DisplayMemberPath="DisplayText"
                             Height="96" />
                </DockPanel>

                <DockPanel Grid.Column="2">
                    <TextBlock DockPanel.Dock="Top" Text="有课名单" Margin="0,0,0,4" />
                    <Button DockPanel.Dock="Bottom"
                            Content="复制有课名单"
                            Command="{Binding CopyBusyStudentsCommand}"
                            HorizontalAlignment="Left"
                            Padding="10,4"
                            Margin="0,6,0,0" />
                    <ListBox ItemsSource="{Binding BusyStudents}"
                             DisplayMemberPath="DisplayText"
                             Height="96" />
                </DockPanel>
            </Grid>
        </Grid>

        <!-- 状态提示 -->
        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource App.Brush.TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
