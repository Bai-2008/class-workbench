<UserControl x:Class="ClassScheduleApp.Views.ClassFundsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 班费记账页：DataContext 由隐式模板继承为 ClassFundsViewModel，后台零逻辑 -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 四张汇总卡：随过滤条件联动 -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,12">
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="当前余额" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding BalanceText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="总收入" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding TotalIncomeText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource App.Brush.PositiveText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="总支出" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding TotalExpenseText}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource App.Brush.ErrorText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="笔数" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="12" />
                    <TextBlock Text="{Binding EntryCountText}" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- 过滤栏 + 两个动作按钮 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="起" VerticalAlignment="Center" Margin="0,0,4,0" />
            <DatePicker SelectedDate="{Binding FilterStart}" Width="130" />
            <TextBlock Text="止" VerticalAlignment="Center" Margin="10,0,4,0" />
            <DatePicker SelectedDate="{Binding FilterEnd}" Width="130" />
            <TextBlock Text="类型" VerticalAlignment="Center" Margin="10,0,4,0" />
            <ComboBox ItemsSource="{Binding TypeOptions}"
                      SelectedItem="{Binding SelectedTypeOption}"
                      MinWidth="110"
                      Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="类别" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategoryOption}"
                      MinWidth="130"
                      Margin="0,0,10,0">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Text="关键词" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,10,0" />
            <Button Content="记一笔" Command="{Binding AddEntryCommand}" Padding="12,4" Margin="0,0,8,0" />
            <Button Content="导出账单" Command="{Binding ExportCommand}" Padding="12,4" />
        </StackPanel>

        <!-- 流水列表：双击编辑；行尾删除走确认框 -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Entries}"
                  SelectedItem="{Binding SelectedEntry}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal">
            <DataGrid.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditEntryCommand}" />
            </DataGrid.InputBindings>
            <DataGrid.Columns>
                <DataGridTextColumn Header="日期" Binding="{Binding DateText}" Width="110" />
                <DataGridTextColumn Header="类型" Binding="{Binding TypeText}" Width="70" />
                <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="120" />
                <DataGridTemplateColumn Header="金额" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding AmountText}" HorizontalAlignment="Right" Margin="0,0,10,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource App.Brush.PositiveText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                <Setter Property="Foreground" Value="{DynamicResource App.Brush.ErrorText}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                <DataGridTextColumn Header="经办人" Binding="{Binding Handler}" Width="110" />
                <DataGridTemplateColumn Header="操作" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="编辑"
                                        Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,2"
                                        Margin="0,0,6,0" />
                                <Button Content="删除"
                                        Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,2" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource App.Brush.TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
