<UserControl x:Class="ClassScheduleApp.Views.WeekGridView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:ClassScheduleApp.ViewModels"
             mc:Ignorable="d">
    <!--
        周视图网格：行 = 节次（复用作息时间数据，第 4/8 节后为午休/晚休分隔），列 = 周一~周日。
        单元格位置由 WeekGridItemViewModel 的 Row/Column/RowSpan 决定（连堂课跨行合并）。
    -->
    <UserControl.Resources>
        <!-- 日期表头（复用列表视图的 DayHeaderItem，今天高亮） -->
        <DataTemplate DataType="{x:Type vm:WeekGridHeaderItem}">
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="0,0,1,1" Padding="6,4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Header.IsToday}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.AccentSurface}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header.WeekdayText}" FontWeight="Bold" Margin="0,0,6,0" />
                        <TextBlock Text="今天" Margin="0" Foreground="{DynamicResource App.Brush.AccentText}" FontSize="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Header.IsToday}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header.DateText}" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="10" />
                        <TextBlock Text="{Binding MarkText}" Margin="6,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource App.Brush.WarningText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMark}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 节次行标签：节次号 + 起止时间 -->
        <DataTemplate DataType="{x:Type vm:WeekGridLabelItem}">
            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="0,0,1,1" Padding="6,4">
                <StackPanel>
                    <TextBlock Text="{Binding PeriodText}" FontWeight="Bold" />
                    <TextBlock Text="{Binding TimeText}" FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- 午休 / 晚休分隔行（视图常量，不落库） -->
        <DataTemplate DataType="{x:Type vm:WeekGridSeparatorItem}">
            <Border Background="{DynamicResource App.Brush.SeparatorSurface}" BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="0,0,0,1" Padding="6,2">
                <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{DynamicResource App.Brush.TextMuted}" HorizontalAlignment="Center" />
            </Border>
        </DataTemplate>

        <!-- 单元格：课程名/教室/教师；同格多门课紧凑纵排并提示点击选择 -->
        <DataTemplate DataType="{x:Type vm:WeekGridCellItem}">
            <Border Margin="1" BorderThickness="1" CornerRadius="3" Padding="4" MinHeight="30">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource App.Brush.SurfaceAlt}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.BorderStrong}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasCourse}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource App.Brush.CourseSurface}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.CourseBorder}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasConflict}" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource App.Brush.ConflictBorder}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftDoubleClick"
                                  Command="{Binding DataContext.OpenCellEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                    <MouseBinding MouseAction="LeftClick"
                                  Command="{Binding DataContext.SelectCellCourseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Border.InputBindings>
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,2">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <!-- 停课：原课程格保留课程名、弱化样式 -->
                                                <DataTrigger Binding="{Binding IsCancelled}" Value="True">
                                                    <Setter Property="Opacity" Value="0.5" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding CourseName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MarkText}" Margin="4,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource App.Brush.WarningText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMark}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <!-- 单双周小标：每周时不显示 -->
                                        <TextBlock Text="{Binding ParityText}" Margin="4,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource App.Brush.AccentText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasParity}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Location}" FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Teacher}" FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding ConflictText}"
                               FontSize="10"
                               Foreground="{DynamicResource App.Brush.WarningText}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 最小宽度保证 7 天列各约 92px：窄窗由外层 ScrollViewer 横向滚动，而不是把列压扁 -->
    <ItemsControl ItemsSource="{Binding WeekGridItems}" MinWidth="780">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!-- 15 行 = 1 表头 + 12 节次 + 2 分隔；8 列 = 1 节次标签 + 7 天 -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
                <Setter Property="Grid.Row" Value="{Binding Row}" />
                <Setter Property="Grid.Column" Value="{Binding Column}" />
                <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
            </Style>
        </ItemsControl.ItemContainerStyle>
    </ItemsControl>
</UserControl>
