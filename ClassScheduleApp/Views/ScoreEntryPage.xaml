<UserControl x:Class="ClassScheduleApp.Views.ScoreEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- 综测记录页：DataContext 由隐式模板继承为 ScoreEntryViewModel，后台零逻辑 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}">
            <!-- 标签页一：记录管理 -->
            <TabItem Header="记录管理">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="学期" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Semesters}"
                                  SelectedItem="{Binding SelectedSemester}"
                                  MinWidth="130"
                                  Margin="0,0,10,0" />
                        <TextBlock Text="学生" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding StudentFilters}"
                                  SelectedItem="{Binding SelectedStudentFilter}"
                                  MinWidth="140"
                                  Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="类别" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding CategoryFilters}"
                                  SelectedItem="{Binding SelectedCategoryFilter}"
                                  MinWidth="120"
                                  Margin="0,0,10,0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayText}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="日期" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <DatePicker SelectedDate="{Binding RangeStart}" Width="130" />
                        <TextBlock Text="~" VerticalAlignment="Center" Margin="6,0,6,0" />
                        <DatePicker SelectedDate="{Binding RangeEnd}" Width="130" />
                        <Button Content="添加记录" Command="{Binding AddEntryCommand}" Padding="12,4" Margin="14,0,0,0" />
                        <Button Content="删除所选"
                                x:Name="DeleteSelectedEntriesButton"
                                IsEnabled="False"
                                Click="DeleteSelectedEntries_Click"
                                Padding="12,4"
                                Margin="8,0,0,0"
                                ToolTip="按住 Ctrl / Shift 在明细表里多选后点击；删除前自动备份，删除后不可恢复" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="EntryList"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Extended"
                              SelectionChanged="EntryList_SelectionChanged"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditEntryCommand}" />
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="日期" Binding="{Binding EntryDateText}" Width="110" />
                            <DataGridTextColumn Header="学生" Binding="{Binding StudentText}" Width="150" />
                            <DataGridTextColumn Header="类别" Binding="{Binding Category}" Width="110" />
                            <DataGridTemplateColumn Header="分数" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ScoreText}" HorizontalAlignment="Right" Margin="0,0,10,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.ErrorText}" />
                                                            <Setter Property="FontWeight" Value="Bold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="说明" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="佐证" Binding="{Binding Evidence}" Width="180" />
                            <DataGridTemplateColumn Header="操作" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="编辑"
                                                    Command="{Binding DataContext.EditEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,2"
                                                    Margin="0,0,6,0" />
                                            <Button Content="删除"
                                                    Command="{Binding DataContext.DeleteEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="10,2" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- 标签页二：学期汇总（列顺序必须与 ScoreCategories.Presets 一致） -->
            <TabItem Header="学期汇总">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="学期" VerticalAlignment="Center" Margin="0,0,4,0" />
                        <ComboBox ItemsSource="{Binding Semesters}"
                                  SelectedItem="{Binding SummarySemester}"
                                  MinWidth="130"
                                  Margin="0,0,12,0" />
                        <Button Content="复制汇总" Command="{Binding CopySummaryCommand}" Padding="12,4" Margin="0,0,8,0" />
                        <Button Content="导出 Excel" Command="{Binding ExportSummaryCommand}" Padding="12,4" />
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Summaries}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="姓名" Binding="{Binding StudentName}" Width="100" />
                            <DataGridTextColumn Header="学号" Binding="{Binding StudentNo}" Width="100" />
                            <DataGridTextColumn Header="品德" Binding="{Binding CategoryScores[品德], StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTextColumn Header="学业" Binding="{Binding CategoryScores[学业], StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTextColumn Header="体育" Binding="{Binding CategoryScores[体育], StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTextColumn Header="美育" Binding="{Binding CategoryScores[美育], StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTextColumn Header="劳动实践" Binding="{Binding CategoryScores[劳动实践], StringFormat={}{0:0.##}}" Width="90" />
                            <DataGridTextColumn Header="社会工作" Binding="{Binding CategoryScores[社会工作], StringFormat={}{0:0.##}}" Width="90" />
                            <DataGridTextColumn Header="竞赛获奖" Binding="{Binding CategoryScores[竞赛获奖], StringFormat={}{0:0.##}}" Width="90" />
                            <DataGridTextColumn Header="扣分" Binding="{Binding CategoryScores[扣分], StringFormat={}{0:0.##}}" Width="70" />
                            <DataGridTemplateColumn Header="总分" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TotalScoreText}" FontWeight="Bold" Margin="4,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTotalNegative}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource App.Brush.ErrorText}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource App.Brush.TextMuted}"
                   Margin="0,10,0,0" />
    </Grid>
</UserControl>
