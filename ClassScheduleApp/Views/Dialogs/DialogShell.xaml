<Window x:Class="ClassScheduleApp.Views.Dialogs.DialogShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:ClassScheduleApp.Views.Dialogs"
        xmlns:vm="clr-namespace:ClassScheduleApp.ViewModels"
        Title="{Binding Title}"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <!--
            弹窗模板注册位：后续模块的弹窗编辑视图在这里加一条隐式 DataTemplate
            （DataType = 弹窗 ViewModel 类型）。见 wpf-mvvm-conventions 的「模板放置规则」。
        -->
        <DataTemplate DataType="{x:Type vm:ExpenseEditViewModel}">
            <dialogs:ExpenseEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScoreEditViewModel}">
            <dialogs:ScoreEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CourseChoiceViewModel}">
            <dialogs:CourseChoiceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScheduleAdjustmentEditViewModel}">
            <dialogs:ScheduleAdjustmentEditView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConfirmActionViewModel}">
            <dialogs:ConfirmActionView />
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 一、标题 -->
        <TextBlock Grid.Row="0"
                   Text="{Binding Title}"
                   FontSize="15"
                   FontWeight="Bold"
                   Margin="0,0,0,12" />

        <!-- 二、内容区：由隐式模板按 ViewModel 类型渲染 -->
        <ContentControl Grid.Row="1" Content="{Binding}" />

        <!-- 三、确定/取消（CanExecute 联动禁用态） -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Padding="14,4"
                    Margin="0,0,8,0"
                    IsCancel="True" />
            <Button Content="确定"
                    Command="{Binding ConfirmCommand}"
                    Padding="14,4"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
