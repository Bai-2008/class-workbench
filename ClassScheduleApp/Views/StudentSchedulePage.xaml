<UserControl x:Class="ClassScheduleApp.Views.StudentSchedulePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:ClassScheduleApp.Views"
             mc:Ignorable="d">
    <!-- 学生课表页：由重构前的 MainWindow 界面原样平移过来，绑定不变 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" MinWidth="180" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="3*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部工具栏：学生维护 -->
        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="新增学生" Command="{Binding AddStudentCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="批量导入" Command="{Binding ImportStudentsCommand}" Padding="10,4" Margin="0,0,8,0" ToolTip="从 .xlsx / .csv 名单批量导入学生；以学号为身份键，已存在即跳过（不覆盖既有信息）" />
            <Button Content="编辑学生" Command="{Binding EditStudentCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="删除学生" Command="{Binding DeleteStudentCommand}" Padding="10,4" Margin="0,0,24,0" />
            <Button Content="删除所选" x:Name="DeleteSelectedButton" IsEnabled="False" Click="DeleteSelectedStudents_Click" Padding="10,4" Margin="0,0,24,0" ToolTip="按住 Ctrl / Shift 在学生列表中多选后点击；删除前会列出影响面并自动备份" />
            <Button Content="选课" Command="{Binding EnrollCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="课程管理" Command="{Binding ManageCoursesCommand}" Padding="10,4" Margin="0,0,8,0" />
            <Button Content="清空该生课表" Command="{Binding ClearStudentScheduleCommand}" Padding="10,4" Margin="0,0,0,0" ToolTip="只解除该生在本学期的全部课程关联；课程实体与考勤记录不受影响" />
        </StackPanel>

        <!-- 左侧：学生列表（约占 1/4 宽度） -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="学生列表" FontWeight="Bold" Margin="0,0,0,8" />
            <ListBox x:Name="StudentList"
                 SelectionMode="Extended"
                 SelectionChanged="StudentList_SelectionChanged"
                 ItemsSource="{Binding Students}"
                     SelectedItem="{Binding SelectedStudent, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}" />
                            <Run Text="  " />
                            <Run Text="{Binding StudentNo, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- 左右分隔条：学生列表宽度可拖拽，两栏按窗口比例自适应 -->
        <GridSplitter Grid.Row="1"
                      Grid.Column="1"
                      Width="6"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="{DynamicResource App.Brush.BorderStrong}"
                      ResizeBehavior="PreviousAndNext"
                      ToolTip="拖动调整学生列表宽度" />

        <!-- 右侧：所选学生的课表 -->
        <DockPanel Grid.Row="1" Grid.Column="2" Margin="12,0,0,0">
            <!-- 追加：周次选择 + 每天日期(M/D)表头，今天高亮；既有课表展示未改动 -->
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="周次" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding WeekOptions}"
                              SelectedItem="{Binding SelectedWeek}"
                              MinWidth="72" />
                    <TextBlock Text="视图" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <ComboBox ItemsSource="{Binding ScheduleViews}"
                              SelectedItem="{Binding ScheduleView}"
                              MinWidth="80" />
                    <Button Content="定位今天"
                            Command="{Binding GoToTodayCommand}"
                            Padding="10,2"
                            Margin="12,0,0,0"
                            ToolTip="把周次切到今天所在的那一周（今天列在网格里高亮）" />
                    <TextBlock Text="{Binding LocateMessage}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.AccentText}" />
                    <TextBlock Text="{Binding WeekHint}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource App.Brush.TextMuted}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding DayHeaders}" Margin="0,8,0,0">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <!-- 网格视图自带日期表头，这里只在列表视图显示，避免重复 -->
                                <DataTrigger Binding="{Binding IsListView}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" Columns="7" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource App.Brush.Border}" BorderThickness="0,0,1,1" Padding="6,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource App.Brush.AccentSurface}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding WeekdayText}" FontWeight="Bold" Margin="0,0,6,0" />
                                        <TextBlock Text="今天" Margin="0" Foreground="{DynamicResource App.Brush.AccentText}" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DateText}" Foreground="{DynamicResource App.Brush.TextMuted}" FontSize="10" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="课表" FontWeight="Bold" Margin="0,0,0,8" />
            <!-- 网格（默认）与列表两种视图并存：列表内容与行为保持原样，只按选择切换可见性 -->
            <Grid>
            <DataGrid ItemsSource="{Binding ScheduleItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserResizeRows="True"
                      RowHeight="28"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Style>
                    <Style TargetType="DataGrid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsListView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <!-- 排序必须绑定数值字段：直接按“周X/1-2节”文本排序会被中文拼音规则排乱 -->
                    <DataGridTextColumn Header="星期" Binding="{Binding WeekdayText}" SortMemberPath="DayOfWeek" Width="80" />
                    <DataGridTemplateColumn Header="节次" SortMemberPath="StartPeriod" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding PeriodText}" />
                                    <TextBlock Text="{Binding PeriodTimeText}" FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding WeekRangeText}" FontSize="10" Foreground="{DynamicResource App.Brush.TextMuted}" />
                                        <!-- 单双周小标：每周时不显示 -->
                                        <TextBlock Text="{Binding ParityText}" Margin="4,0,0,0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource App.Brush.AccentText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ParityText}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding ParityText}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="课程名" Binding="{Binding ScheduleDisplayText}" Width="2*" />
                    <DataGridTextColumn Header="教室" Binding="{Binding Location}" Width="*" />
                    <DataGridTextColumn Header="授课老师" Binding="{Binding Teacher}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <!-- 网格放进滚动容器：窄窗时横向滚动（列不再被压到看不清），行多时纵向滚动（第 9-12 节可见） -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGridView}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <views:WeekGridView MinWidth="780" />
            </ScrollViewer>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
