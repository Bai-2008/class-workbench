<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        深色主题：只提供调色板。
        控件外观统一由 Themes/ControlStyles.xaml 提供（与浅色共用同一套设计）。
    -->
    <SolidColorBrush x:Key="App.Brush.Window" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="App.Brush.Surface" Color="#FF252526" />
    <SolidColorBrush x:Key="App.Brush.SurfaceAlt" Color="#FF2D2D30" />
    <SolidColorBrush x:Key="App.Brush.Border" Color="#FF3F3F46" />
    <SolidColorBrush x:Key="App.Brush.BorderStrong" Color="#FF5A5A63" />
    <SolidColorBrush x:Key="App.Brush.Text" Color="#FFE8E8E8" />
    <SolidColorBrush x:Key="App.Brush.TextMuted" Color="#FF9A9A9A" />
    <SolidColorBrush x:Key="App.Brush.AccentSurface" Color="#FF4A3F1E" />
    <SolidColorBrush x:Key="App.Brush.AccentText" Color="#FFE8C46A" />
    <SolidColorBrush x:Key="App.Brush.CourseSurface" Color="#FF243447" />
    <SolidColorBrush x:Key="App.Brush.CourseBorder" Color="#FF3E6B9E" />
    <SolidColorBrush x:Key="App.Brush.ConflictBorder" Color="#FFB98A3A" />
    <SolidColorBrush x:Key="App.Brush.WarningSurface" Color="#FF3A2F1A" />
    <SolidColorBrush x:Key="App.Brush.WarningBorder" Color="#FF7A6534" />
    <SolidColorBrush x:Key="App.Brush.WarningText" Color="#FFE0C080" />
    <SolidColorBrush x:Key="App.Brush.ErrorText" Color="#FFFF6B6B" />
    <SolidColorBrush x:Key="App.Brush.SeparatorSurface" Color="#FF303034" />
    <SolidColorBrush x:Key="App.Brush.TagSurface" Color="#FF3A3A3F" />
    <SolidColorBrush x:Key="App.Brush.PositiveText" Color="#FF5BB974" />
    <SolidColorBrush x:Key="App.Brush.FreeSurface" Color="#FF1F3D2A" />
    <SolidColorBrush x:Key="App.Brush.SelectedBorder" Color="#FF6BA9E8" />
    <SolidColorBrush x:Key="App.Brush.ScrollThumb" Color="#FF5A5A63" />
</ResourceDictionary>
